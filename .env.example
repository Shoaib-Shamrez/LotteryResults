# LotteryResults — frontend environment variables (example only; no real values).
# Copy this file to ".env" and fill in the values for your environment.
# Never commit a real .env file. .env is gitignored.

# Public base URL of the backend API. Leave EMPTY for local dev (Vite proxies
# /api/* to the backend on http://localhost:5000 via the VITE_API_PROXY_TARGET
# env var, which itself defaults to http://localhost:5000).
#
# For production, set this to the backend origin WITHOUT a trailing /api
# (e.g. https://api.your-domain.com). The apiUrl() helper appends /api.
#
# Allowed values:
#   - empty string  : use Vite proxy (local dev)
#   - https://api.your-domain.com : explicit backend origin (cross-site)
VITE_API_BASE_URL=

# Local dev proxy target. The Vite dev server forwards /api/* to this URL.
# Only used by the Vite proxy in development; ignored in production builds.
# Defaults to http://localhost:5000 if unset.
VITE_API_PROXY_TARGET=http://localhost:5000
